# URL van je gedeployde backend (garderobe-backend), zonder trailing slash.
# Lokaal ontwikkelen tegen `npm run dev` in garderobe-backend:
VITE_API_BASE=http://localhost:3000

# Zodra je backend op Railway/Render draait, vervang je dit door bv.:
# VITE_API_BASE=https://garderobe-backend-production.up.railway.app
